    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261002.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "^5.7.0",
    "vite": "8.3.2",
    "vitest": "5.0.3",
    "wrangler": "4.146.0"
  }
}
